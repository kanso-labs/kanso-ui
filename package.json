{
  "name": "@kanso-labs/kanso-ui",
  "version": "0.11.21",
  "description": "A React component library built on Base UI primitives and styled with StyleX, with design tokens sourced from a single W3C DTCG file and compiled via Style Dictionary",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "base-ui",
    "stylex",
    "design-tokens",
    "style-dictionary",
    "storybook"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanso-labs/kanso-ui.git"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "clean": "rimraf dist",
    "dev": "npm run storybook",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware . && eslint . && npm run format:check",
    "prepare": "husky && playwright install --with-deps chromium",
    "storybook": "storybook dev -p ${PORT:-6006}",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tokens:build": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@chromatic-com/storybook": "5.3.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@kanso-labs/unplugin-style-dictionary": "0.4.18",
    "@rolldown/plugin-babel": "0.2.3",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/builder-vite": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@stylexjs/unplugin": "0.19.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-oxlint": "1.81.0",
    "eslint-plugin-perfectionist": "5.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "oxc-transform-react": "0.145.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "storybook": "10.6.0",
    "style-dictionary": "5.5.2",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
