{
  "name": "@kanso-labs/kanso-ui",
  "version": "0.36.0",
  "description": "A React component library built on React Aria Components primitives and styled with StyleX, with design tokens sourced from a single W3C DTCG file and compiled via Style Dictionary",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "react-aria",
    "stylex",
    "design-tokens",
    "style-dictionary",
    "storybook"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "default": "./dist/date.js"
    },
    "./styles.css": {
      "types": "./dist/stylesheet.d.ts",
      "default": "./dist/styles.css"
    },
    "./tokens.css": {
      "types": "./dist/stylesheet.d.ts",
      "default": "./dist/tokens.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanso-labs/kanso-ui.git"
  },
  "scripts": {
    "api:update": "node scripts/api-report.mjs --local",
    "build": "tsc -b && tsdown",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "clean": "rimraf dist",
    "component:new": "node scripts/new-component.mjs",
    "dev": "npm run storybook",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware . && eslint . && npm run format:check",
    "package:check": "publint && attw --pack --profile esm-only && node scripts/check-package.mjs && node scripts/api-report.mjs",
    "prepare": "husky && playwright install --with-deps chromium",
    "storybook": "storybook dev -p ${PORT:-6006}",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tokens:build": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@internationalized/string": "3.2.10",
    "react-aria-components": "1.21.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "7.29.7",
    "@chromatic-com/storybook": "5.4.0",
    "@codecov/rollup-plugin": "2.0.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@kanso-labs/unplugin-style-dictionary": "0.10.17",
    "@microsoft/api-extractor": "7.59.4",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/builder-vite": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-oxlint": "1.87.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lightningcss": "1.33.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "storybook": "10.6.1",
    "style-dictionary": "5.6.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
