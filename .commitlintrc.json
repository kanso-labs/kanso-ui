{
  "extends": ["@commitlint/config-conventional"],
  "helpUrl": "https://github.com/kanso-labs/kanso-ui/blob/main/AGENTS.md#commits-and-pull-requests",
  "rules": {
    "header-max-length": [0],
    "type-enum": [
      2,
      "always",
      [
        "build",
        "chore",
        "ci",
        "deps",
        "docs",
        "feat",
        "fix",
        "perf",
        "refactor",
        "revert",
        "style",
        "test"
      ]
    ]
  }
}
