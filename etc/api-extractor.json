{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "apiReport": {
    "enabled": true,
    "reportFileName": "index",
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/node_modules/.tmp/api-extractor/"
  },
  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": []
      },
      "include": ["dist"]
    }
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "mainEntryPointFilePath": "<projectFolder>/dist/index.d.ts",
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      "ae-unresolved-link": {
        "logLevel": "none"
      },
      "default": {
        "addToApiReportFile": true,
        "logLevel": "warning"
      }
    },
    "tsdocMessageReporting": {
      "default": {
        "logLevel": "none"
      }
    }
  },
  "newlineKind": "lf",
  "projectFolder": "..",
  "tsdocMetadata": {
    "enabled": false
  }
}
