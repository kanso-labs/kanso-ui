{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    // ES2023.Intl for NumberFormat's `negative` and `exceptZero` sign
    // displays, which Currency uses to leave a zero bare. Chromium 106,
    // Safari 15.4 and Firefox 116 run them.
    "lib": ["ES2022", "ES2023.Intl", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    // So a test can assert against src/tokens/design.tokens.json, the DTCG
    // source every generated token file is built from — see
    // src/tokens/motion.values.test.ts. Vite resolves JSON imports natively;
    // this only tells tsc the same.
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
